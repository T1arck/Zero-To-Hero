cat > .gitignore << 'EOF'
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Виртуальное окружение
venv/
env/
ENV/

# Flask и базы данных
instance/
*.db
*.sqlite
*.sqlite3
.env

# IDE и редакторы
.vscode/
.idea/
*.swp
*.swo
*~

# Операционные системы
.DS_Store
Thumbs.db
EOF